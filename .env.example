# ==============================================================================
# FIRMUS — Environment Configuration Template (.env.example)
# Nusxa oling: cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Baza, Autentifikatsiya va RLS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------------------
# 2. Asosiy Ilova URL manzili
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://app.firmus.uz

# ------------------------------------------------------------------------------
# 3. AI Copilot & Hujjat Skaneri (Google Gemini API)
# Bepul kalit olish: https://aistudio.google.com
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------------------------
# 4. Integratsiyalar Xavfsizlik Kaliti (AES-256-GCM Shifrlash)
# 1C OData parollari va tashqi integratsiya ma'lumotlarini bazada shifrlash uchun.
# Masalan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
INTEGRATION_ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# ------------------------------------------------------------------------------
# 5. To'lov Tizimlari (Payme & Click Webhook & Checkout)
# ------------------------------------------------------------------------------
# Payme Merchant sozlamalari
PAYME_MERCHANT_ID=your-payme-merchant-id
PAYME_SECRET_KEY=your-payme-secret-key
# Click Merchant sozlamalari
CLICK_SERVICE_ID=your-click-service-id
CLICK_MERCHANT_ID=your-click-merchant-id
CLICK_SECRET_KEY=your-click-secret-key

# Xavfsizlik: Sandbox tasdiqlash (faqat development uchun)
# Ishlab chiqarishda (production) bu har doim "false" bo'lishi shart!
ALLOW_SANDBOX_CONFIRM=false
PAYMENT_LIVE_STRICT=true

# ------------------------------------------------------------------------------
# 6. B2B / Didox Hisob-faktura uchun Sotuvchi Rekvizitlari
# ------------------------------------------------------------------------------
FIRMUS_SELLER_NAME="FIRMUS SOFT" MChJ
FIRMUS_SELLER_TIN=310987654
FIRMUS_SELLER_ACCOUNT=20208000600000000001
FIRMUS_SELLER_BANK="KAPITALBANK" ATB Toshkent shahar filiali
FIRMUS_SELLER_MFO=00974
